// Teste de condicionais if
var a = 10;
var b = 20;

if (a < b) {
  print "a é menor que b";
}

if (a > b) {
  print "a é maior que b";
} else {
  print "a não é maior que b";
}

// Teste de condicionais aninhadas
if (a > 0) {
  if (b > 0) {
    print "ambos positivos";
  } else {
    print "a positivo, b não";
  }
} else {
  print "a não é positivo";
}

// Teste de operadores lógicos
if (a > 0 and b > 0) {
  print "ambos são positivos usando AND";
}

if (a < 0 or b > 0) {
  print "pelo menos um é positivo usando OR";
}
